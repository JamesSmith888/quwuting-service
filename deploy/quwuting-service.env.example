# quwuting-service 运行环境变量
# 部署位置：/etc/quwuting-service.env
# 权限：root:appuser 640（deploy.sh 自动固化）
# ─── 操作流程 ───
#   sudo cp deploy/quwuting-service.env.example /etc/quwuting-service.env
#   sudo chmod 600 /etc/quwuting-service.env
#   sudo $EDITOR /etc/quwuting-service.env
#   sudo bash deploy/deploy.sh

# ── JVM 参数（针对 2 vCPU / 2 GB 主机的实测合理值） ─────────────────────
# - Xmx512m: 堆上限。RSS 实际约 Xmx + 250MB(metaspace+direct+code+threads) ≈ 800MB。
# - Xms256m: 初始堆。避免冷启动反复扩堆抖动。
# - MaxMetaspaceSize=192m: 防止类元数据缓慢膨胀（Spring/Hibernate 反射重灾区）。
# - +ExitOnOutOfMemoryError: JVM 内 OOM 立刻退出，让 systemd 在 10s 内拉起。
# - +HeapDumpOnOutOfMemoryError + Path: 留 hprof，事后用 Eclipse MAT 分析。
# - -Djava.security.egd=file:/dev/./urandom: 防止 JVM 启动时阻塞在熵池上。
JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/quwuting-service/ -Djava.security.egd=file:/dev/./urandom

# ── 数据库（必填） ───────────────────────────────────────────────────────
# Supabase 事务池化（6543），URL 必须含 prepareThreshold=0（见 AGENTS.md）
DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

# ── 微信 & JWT（必填） ───────────────────────────────────────────────────
WECHAT_SECRET=replace-me
JWT_SECRET=replace-with-32byte-secret

# ── Supabase Storage（必填） ─────────────────────────────────────────────
SUPABASE_PROJECT_URL=replace-me
SUPABASE_ANON_KEY=replace-me

# ── 可选 ─────────────────────────────────────────────────────────────────
# SUPABASE_STORAGE_BUCKET=qwt-public
