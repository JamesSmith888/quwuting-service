<?xml version="1.0" encoding="UTF-8"?>
<settings xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd"
          xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- 临时 settings：绕过公司私服 trip-maven-prod，全部走 Maven Central（直连可达）。
         id 用 central-direct 以命中本地已有缓存。使用：./mvnw -s settings-central.xml ... -->
    <mirrors>
        <mirror>
            <id>central-direct</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
